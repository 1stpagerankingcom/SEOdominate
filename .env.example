# Server
PORT=3000

# Public app URL — used for shareable report links & emails
APP_URL=https://your-app.vercel.app

# Make.com webhook for lead capture (CRM/GHL integration)
MAKE_WEBHOOK_URL=https://hook.us2.make.com/b5jpbz7soz332cqcn3n67olhg32h59k5

# ---- LIVE DATA (all optional — tool runs in Simulation mode when unset) ----

# Google Places API (New) — real GBP profile data, competitor lookup, geocoding
# https://console.cloud.google.com/google/maps-apis
GOOGLE_PLACES_API_KEY=

# RankNibbler — real on-page SEO audit (AEO/GEO scorecards), 100 req/day free
# https://www.ranknibbler.com/api/keys
RANKNIBBLER_API_KEY=

# DataForSEO — real Google Maps Local Pack + geographic grid rankings (heatmaps)
# https://www.dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# LLM routing — AI visibility checks (6 platforms) + AI-written summaries.
# Set OPENROUTER_KEY for real per-platform checks (openrouter.ai).
# Or set LLM_BASE_URL to an OpenAI-compatible router (e.g. OmniRoute http://localhost:20128/v1);
# localhost routers use the router's own model combo (auto/best-free).
OPENROUTER_KEY=
LLM_BASE_URL=

# ---- PERSISTENCE ----
# Teable (airtable-like DB) — shared-table multi-tenant base: Agencies/Audits/Leads/Reviews.
# Records are scoped to an agency via the Agency link field; lead creation + integration-health
# + review moderation are handled by Teable automations (see TEABLE_AI_BRIEF.md Prompts 7-8).
# https://app.teable.io  → Account Settings > Access Tokens (table record read/write)
TEABLE_API_URL=https://app.teable.io
TEABLE_API_TOKEN=
# Table IDs default to the live SEODominate base when left blank.
TEABLE_AGENCIES_TABLE_ID=tbl5b86wLW5laiJvoQM
TEABLE_AUDITS_TABLE_ID=tblhzAPtGU4aiVYuQiV
TEABLE_LEADS_TABLE_ID=tblFlNBFVeISLbGWDS8
TEABLE_REVIEWS_TABLE_ID=tbllV46BlD4t6NmfYKl

# ---- EMAIL DELIVERY (nodemailer) ----
# Resend SMTP relay: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=<Resend API key>
# (Resend only accepts From addresses on domains verified in your Resend account.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=SEODominate <hello@your-verified-domain.com>

# ---- AGENCY / AUTOMATION ----
# SERPwin (or any) webhook that receives the full audit payload on completion
SERPWIN_WEBHOOK_URL=

# Follow-up webhook (Make/Zapier/n8n) — fired when an audit is completed so your
# CRM can start a nurture sequence. Payload: { type:'audit_completed', business, email, score }
FOLLOWUP_WEBHOOK_URL=

# Manager dashboard auth
MANAGER_TOKEN=seoaudit-manager-2026

# ---- WHITE-LABEL BRANDING ----
# These make the tool fully resellable under an agency's own brand.
BRAND_NAME=SEOAudit
BRAND_LOGO_URL=
BRAND_COLOR=#6c5ce7
BRAND_EMAIL=hello@seoaudit.local
AI_ASSISTANT_NAME=Aria

# ---- BOT PROTECTION (optional — security is auto-disabled when keys are empty) ----
# Google reCAPTCHA — classic v2/v3 OR Enterprise:
#  - Classic: https://www.google.com/recaptcha/admin  (site key + secret)
#  - Enterprise (project "seodominate"): RECAPTCHA_PROJECT_ID + GOOGLE_CLOUD_API_KEY
#    verify via recaptchaenterprise.googleapis.com/v1/projects/{id}/assessments
#    (Enterprise API must be enabled + billing active on the GCP project).
#    Frontend auto-switches to recaptcha/enterprise.js when both are set.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_PROJECT_ID=
GOOGLE_CLOUD_API_KEY=

# ---- DEMO / SANDBOX ----
# Set to '1' to force every audit into instant demo mode (pure mock, no email/webhooks/persist)
DEMO_MODE=

# ---- AGENCY MULTI-TENANCY (SEODominate platform) ----
# Agencies register via /agency and bring their own API keys + branding.
# AGENCY_KEY_ENCRYPTION_KEY encrypts agency API keys at rest (AES-256-GCM).
# If unset, keys are stored as plaintext in agencies.json — ALWAYS set this in production.
AGENCY_KEY_ENCRYPTION_KEY=

# HMAC secret that signs agency session tokens. If unset a random one is generated
# at boot (which logs every agency out on restart). Set a stable value in production.
AGENCY_SESSION_SECRET=
