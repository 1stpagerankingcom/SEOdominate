{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/report/(.*)", "dest": "server.js" },
    { "src": "/a/(.*)", "dest": "server.js" },
    { "src": "/agency", "dest": "server.js" },
    { "src": "/manager", "dest": "server.js" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
